# FYERS Trading API v3 — credentials (copy to .env and fill in; never commit .env)
# Create an app at https://myapi.fyers.in/dashboard/ to get these values.

# App / client ID, format like "SPXXXXE7-100"
FYERS_APP_ID=

# App secret
FYERS_SECRET_ID=

# Redirect URI registered on the app (must match exactly)
FYERS_REDIRECT_URI=https://trade.fyers.in/api-login/redirect-uri/index.html

# Optional: user PIN, only needed for the refresh-token flow
# FYERS_PIN=
